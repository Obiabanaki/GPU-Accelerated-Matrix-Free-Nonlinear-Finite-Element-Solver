{
  "_comment": "Same problem as example_problem.json, but with every switchable option set differently — tet4 elements, Mooney-Rivlin material, direct linear solver. Run both and diff the trace output to see the object-creation choices change while the orchestration logic doesn't.",

  "mesh": {
    "type": "structured_cube",
    "element_counts": [2, 2, 2],
    "element_size": [0.5, 0.5, 0.5],
    "element_type": "tet4"
  },

  "material": {
    "type": "mooney-rivlin",
    "params": { "c10": 0.6, "c01": 0.4, "kappa": 10.0 }
  },

  "boundary_conditions": [
    { "type": "dirichlet", "face": "x_min", "value": [0.0, 0.0, 0.0] },
    { "type": "dirichlet", "face": "x_max", "value": [0.2, 0.0, 0.0] }
  ],

  "solver": {
    "linear_solver": "direct",
    "preconditioner": "identity",
    "tolerance": 1e-8,
    "max_iterations": 500
  },

  "newton": {
    "load_steps": 2,
    "residual_tolerance": 1e-6,
    "displacement_tolerance": 1e-6,
    "max_iterations_per_step": 5
  }
}
